# Nebius Token Factory & NVIDIA Nemotron Configuration
# Leave blank to run safely in offline Demo Mode (zero cost guaranteed).
#
# Base URL for Nebius Token Factory:
SOMNIA_AI_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Your Nebius Token Factory API Key (Never commit or share this!):
SOMNIA_AI_API_KEY=

# Supported NVIDIA Open-Source Model on Nebius Token Factory:
# Recommended: nvidia/nemotron-3-super-120b-a12b
# Or: nvidia/Nemotron-3_5-Lightning
SOMNIA_AI_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Custom Port and SQLite Database Path
# SOMNIA_PORT=8787
# SOMNIA_DB_PATH=./data/somnia.sqlite
