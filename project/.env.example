# AI Provider Configuration (OpenAI-compatible)
# For Nebius AI Studio, use:
#   SOMNIA_AI_BASE_URL=https://api.studio.nebius.ai/v1
#   SOMNIA_AI_API_KEY=<your-nebius-api-key>
#   SOMNIA_AI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
#
# Leave SOMNIA_AI_API_KEY and SOMNIA_AI_MODEL blank for local demo mode.
SOMNIA_AI_BASE_URL=https://api.studio.nebius.ai/v1
SOMNIA_AI_API_KEY=
SOMNIA_AI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional SQLite database path. Defaults to somnia.db.
# SOMNIA_DB_PATH=somnia.db
# SOMNIA_PORT=8787
